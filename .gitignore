# Generated by the direct ESPHome component bootstrap on the build host.
# Each component's tracked __init__.py is only a tiny source-loader stub.
# Ignore downloaded (third-party) code so ESPHome's daily Git refresh does
# not stash hundreds of untracked compiled component source files.
/components/wmbus_common/*
/components/wmbus_radio/*
/components/wmbus_meter/*
/components/socket_transmitter/*

# ESPHome direct GitHub component: downloaded source and verified initializer cache
/components/.shwm_v4_cache/
/components/.shwm_v4_ready
/.shwm_v4_install.lock
