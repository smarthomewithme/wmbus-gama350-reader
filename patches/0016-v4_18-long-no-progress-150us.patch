+// SHWM v4.18: evaluate 150us long-payload idle polls between 100us and 200us.
+// Preserve short-frame policy and the 100us unstable-RXBYTES backoff.
+inline constexpr unsigned int rx_v418_no_progress_backoff_us(uint32_t offset,
+                                                             std::size_t length) {
+  return offset == 3u && length >= 250u ? 150u
+                                       : rx_v417_no_progress_backoff_us(offset, length);
+}
+
 // CC1101 RXBYTES is asynchronous to SPI. Require two consecutive equal reads.
