diff --git a/components/wmbus_radio/long_gap_diagnostics.h b/components/wmbus_radio/long_gap_diagnostics.h
new file mode 100644
--- /dev/null
+++ b/components/wmbus_radio/long_gap_diagnostics.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <cstdint>
+
+namespace esphome {
+namespace wmbus_radio {
+
+// Approximate missing slots only; CC1101 cannot prove a telegram was sent.
+// Round a gap to nearest 30 s and subtract the one observed frame.
+constexpr inline uint32_t estimate_missing_30s_periods(uint32_t gap_ms) {
+  if (gap_ms < 45000u)
+    return 0u;
+  return gap_ms / 30000u + ((gap_ms % 30000u >= 15000u) ? 1u : 0u) - 1u;
+}
+
+}  // namespace wmbus_radio
+}  // namespace esphome
