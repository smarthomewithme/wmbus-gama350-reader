+// SHWM v4.9: active RX can return a transient MARCSTATE (SWRZ020E).
+// Only a suspicious end state gets extra SPI reads; never delay normal RX.
+// Require two consecutive identical terminal samples, within three retries.
+// An intermediate non-terminal state cancels the proposed end immediately.
+template <typename ReadStatus, typename IsTerminal>
+inline bool confirm_marcstate_eof(uint8_t first, ReadStatus read_status,
+                                  IsTerminal is_terminal) {
+  if (!is_terminal(first))
+    return false;
+  uint8_t previous = first;
+  for (unsigned int attempt = 0; attempt < 3; ++attempt) {
+    const uint8_t current = read_status();
+    if (!is_terminal(current))
+      return false;
+    if (current == previous)
+      return true;
+    previous = current;
+  }
+  return false;
+}
+
 }  // namespace wmbus_radio
 }  // namespace esphome
