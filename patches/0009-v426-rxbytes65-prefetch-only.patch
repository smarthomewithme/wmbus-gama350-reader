diff --git a/components/wmbus_radio/cc1101_fifo.h b/components/wmbus_radio/cc1101_fifo.h
--- a/components/wmbus_radio/cc1101_fifo.h
+++ b/components/wmbus_radio/cc1101_fifo.h
@@ -1,7 +1,36 @@
 #pragma once
+#include <cstddef>
 #include <cstdint>
 
 namespace esphome {
 namespace wmbus_radio {
 
+// SWRZ020E: CC1101 reports 64 FIFO bytes plus one SPI prefetch byte.
+// A stable RXBYTES=65 without the overflow flag is not an invalid count.
+constexpr uint8_t kCc1101MaxReportedRxBytes = 65;
+constexpr std::size_t kCc1101PhysicalFifoBytes = 64;
+
+inline constexpr bool rx_fifo_count_plausible(uint8_t available) {
+  return available <= kCc1101MaxReportedRxBytes;
+}
+
+// Preserve the last byte until the packet is complete (CC1101 erratum).
+inline constexpr std::size_t rx_fifo_incomplete_read(uint8_t available,
+                                                    std::size_t remaining) {
+  if (available < 2 || !rx_fifo_count_plausible(available))
+    return 0;
+  const std::size_t safe = static_cast<std::size_t>(available - 1);
+  return safe < remaining ? safe : remaining;
+}
+
+// A single SPI FIFO burst must not exceed the 64 physically stored bytes.
+// When RXBYTES=65 and 65 bytes remain, drain 64 and then the final byte.
+inline constexpr std::size_t rx_fifo_complete_read(uint8_t available,
+                                                  std::size_t remaining) {
+  if (!rx_fifo_count_plausible(available) || !remaining ||
+      static_cast<std::size_t>(available) < remaining)
+    return 0;
+  return remaining < kCc1101PhysicalFifoBytes ? remaining : kCc1101PhysicalFifoBytes;
+}
+
 // CC1101 RXBYTES is asynchronous to SPI. Require two consecutive equal reads.
