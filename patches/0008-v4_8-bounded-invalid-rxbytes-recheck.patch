+// Used ONLY after an already stable, non-overflow, impossible RXBYTES count.
+// Bounded retries (3), preserving the original sample on any failure.
+// Passing 0/64 is safe: the caller's regular FIFO accounting handles it.
+template <typename StableRead, typename Pause>
+inline bool retry_invalid_fifo_count(uint8_t &raw, StableRead stable_read, Pause pause) {
+  if ((raw & 0x80u) != 0u || (raw & 0x7Fu) <= 64u)
+    return false;
+  for (unsigned int attempt = 0; attempt < 3; ++attempt) {
+    pause();
+    uint8_t candidate = 0;
+    if (!stable_read(candidate))
+      continue;
+    if ((candidate & 0x80u) == 0u && (candidate & 0x7Fu) <= 64u) {
+      raw = candidate;
+      return true;
+    }
+  }
+  return false;
+}
