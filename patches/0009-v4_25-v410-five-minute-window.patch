new file mode 100644
--- /dev/null
+++ b/components/wmbus_radio/rx_diag_window.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <cstdint>
+
+namespace esphome {
+namespace wmbus_radio {
+
+// Pure counters only: no SPI reads, radio configuration or receiver-task work.
+struct RxDiagSnapshot {
+  uint32_t irq_notifications{0};
+  uint32_t headers_ok{0};
+  uint32_t headers_failed{0};
+  uint32_t payloads_ok{0};
+  uint32_t payloads_failed{0};
+  uint32_t long_radio_frames{0};
+  uint32_t queue_drops{0};
+  uint32_t frame_converted{0};
+  uint32_t frame_conversion_failed{0};
+};
+
+// Unsigned subtraction also handles 32-bit counter rollover.
+inline RxDiagSnapshot rx_diag_delta(const RxDiagSnapshot &now,
+                                    const RxDiagSnapshot &before) {
+  return {
+      now.irq_notifications - before.irq_notifications,
+      now.headers_ok - before.headers_ok,
+      now.headers_failed - before.headers_failed,
+      now.payloads_ok - before.payloads_ok,
+      now.payloads_failed - before.payloads_failed,
+      now.long_radio_frames - before.long_radio_frames,
+      now.queue_drops - before.queue_drops,
+      now.frame_converted - before.frame_converted,
+      now.frame_conversion_failed - before.frame_conversion_failed,
+  };
+}
+
+}  // namespace wmbus_radio
+}  // namespace esphome
